---
interface Props {
  phone?: string;
  region?: string;
}

import { areas } from '../data/areas';

const { phone = '406-539-9641', region = '[Your Region]' } = Astro.props;
---

<section class="service-areas" id="service-areas">
  <div class="container areas-inner">
    <div class="areas-copy">
      <h2>
        Proudly Serving
        <span class="accent">{region}</span>
      </h2>
      <p>
        Legacy Moving covers local residential moves throughout {region} and the surrounding
        communities. If you're within driving distance, chances are we already serve your area.
      </p>
      <a class="btn-secondary" href={`tel:${phone.replace(/[^\d+]/g, '')}`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"
            fill="currentColor"
          />
        </svg>
        Not Sure? Call to Confirm — {phone}
      </a>
    </div>

    <div class="areas-grid">
      {areas.map((area) => (
        <a class="area-chip" href={`/moving-company-${area.slug}/`}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M12 21s7-6.5 7-11.5A7 7 0 0 0 5 9.5C5 14.5 12 21 12 21z"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linejoin="round"
            />
            <circle cx="12" cy="9.5" r="2.4" stroke="currentColor" stroke-width="1.8" />
          </svg>
          {area.name}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .service-areas {
    background: var(--color-muted);
    padding-block: var(--space-8);
    scroll-margin-top: 96px;
  }
  .areas-inner {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: var(--space-7);
    align-items: center;
  }

  .areas-copy h2 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2.2rem, 3.8vw, 3.1rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-fg);
    margin-bottom: var(--space-4);
  }
  .areas-copy h2 .accent {
    display: block;
    color: var(--color-primary);
  }
  .areas-copy p {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-gray);
    margin-bottom: var(--space-5);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px;
    border-radius: var(--radius-pill);
    background: var(--color-dark);
    color: var(--color-dark-fg);
    text-decoration: none;
    font-weight: 700;
    font-family: var(--font-heading);
  }

  .areas-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .area-chip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 20px;
    border-radius: var(--radius-md);
    background: #ffffff;
    border: 1px solid var(--color-border);
    color: var(--color-fg);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.98rem;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .area-chip:hover,
  .area-chip:focus-visible {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }
  .area-chip svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .areas-inner {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .areas-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
