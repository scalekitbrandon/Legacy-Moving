---
interface Props {
  phone?: string;
  image?: string;
  imageAlt?: string;
}

const { phone = '406-539-9641', image, imageAlt = 'Legacy Moving crew at work' } = Astro.props;
---

<section class="why-us">
  <div class="container why-inner">
    <div class="why-copy">
      <h2>
        Why
        <span class="accent">Legacy</span>
        Moving?
      </h2>

      <p>
        We built Legacy Moving around one idea: your move should feel handled, not stressful.
        Our licensed, insured crews cover local <span class="hl">residential moves</span>, careful
        <span class="hl">packing services</span>, and <span class="hl">custom crating</span> —
        all with the same crew from start to finish, so nothing gets lost in the handoff.
      </p>

      <p>
        From walk-up apartments to full single-family homes, our movers understand the details
        that actually matter on move day — protecting floors and furniture, communicating clear
        arrival windows, and pricing every move with <span class="hl">transparent, upfront quotes</span>.
        Whether it's a studio down the street or a full home across town, Legacy Moving treats
        every move like it's the only one we're doing that day.
      </p>

      <div class="why-actions">
        <a class="btn-primary" href="/contact">
          Get a Quote
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a class="btn-secondary" href={`tel:${phone.replace(/[^\d+]/g, '')}`}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"
              fill="currentColor"
            />
          </svg>
          {phone}
        </a>
      </div>
    </div>

    <div class="why-media">
      {image ? (
        <img src={image} alt={imageAlt} loading="lazy" />
      ) : (
        <div class="why-media-placeholder">Photo</div>
      )}
    </div>
  </div>
</section>

<style>
  .why-us {
    background: var(--color-bg);
    padding-block: var(--space-8);
  }
  .why-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    align-items: center;
  }

  .why-copy h2 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-fg);
    margin-bottom: var(--space-4);
  }
  .why-copy h2 .accent {
    display: block;
    color: var(--color-primary);
  }

  .why-copy p {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-gray);
    margin-bottom: var(--space-4);
  }
  .why-copy p .hl {
    color: var(--color-accent);
    font-weight: 600;
  }

  .why-actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-5);
    flex-wrap: wrap;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 26px;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-primary-fg);
    text-decoration: none;
    font-weight: 700;
    font-family: var(--font-heading);
  }
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px;
    border-radius: var(--radius-pill);
    background: var(--color-dark);
    color: var(--color-dark-fg);
    text-decoration: none;
    font-weight: 700;
    font-family: var(--font-heading);
  }

  .why-media img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 60px rgba(1, 19, 47, 0.18);
  }
  .why-media-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    border: 2px dashed var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gray);
    font-family: var(--font-body);
    font-size: 0.9rem;
    background: var(--color-muted);
  }

  @media (max-width: 900px) {
    .why-inner {
      grid-template-columns: 1fr;
    }
    .why-media {
      order: -1;
    }
  }
</style>
