---
interface Props {
  phone?: string;
  quoteHref?: string;
  heading?: string;
}

const { phone = '406-539-9641', quoteHref = '#quote', heading = 'Ready to Get Moving?' } = Astro.props;
---

<section class="closing-cta">
  <div class="container closing-inner">
    <h2>{heading}</h2>
    <p>Get a free, no-obligation quote in under 60 seconds — no pushy sales call required.</p>

    <div class="closing-actions">
      <a class="btn-primary" href={quoteHref}>
        Get My Free Quote
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a class="btn-secondary" href={`tel:${phone.replace(/[^\d+]/g, '')}`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"
            fill="currentColor"
          />
        </svg>
        {phone}
      </a>
    </div>
  </div>
</section>

<style>
  .closing-cta {
    background-color: var(--color-dark);
    background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1.5px);
    background-size: 22px 22px;
    padding-block: var(--space-8);
    text-align: center;
  }
  .closing-inner h2 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-bottom: var(--space-3);
  }
  .closing-inner p {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.65);
    max-width: 520px;
    margin: 0 auto var(--space-6);
  }

  .closing-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 15px 28px;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-primary-fg);
    text-decoration: none;
    font-weight: 700;
    font-family: var(--font-heading);
  }
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 28px;
    border-radius: var(--radius-pill);
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
    font-family: var(--font-heading);
  }
</style>
