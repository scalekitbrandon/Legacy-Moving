---
// Standardized city page template. See the astro-seo-architecture skill's
// "CITY PAGE TEMPLATE" section for the structure this follows:
// Hero -> Trust Bar -> Services -> Why Legacy -> Local Guide -> Process ->
// Reviews -> Nearby Areas -> FAQ -> Final CTA.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import HowItWorks from './HowItWorks.astro';
import ClosingCta from './ClosingCta.astro';
import BreadcrumbSchema from './BreadcrumbSchema.astro';
import { services } from '../data/services';
import { areas, type Area } from '../data/areas';
import { navLinks, footerGroups, PHONE, EMAIL } from '../data/site';

interface Props {
  area: Area;
}

const { area } = Astro.props;
const guide = area.guide!;
const phoneHref = `tel:${PHONE.replace(/[^\d+]/g, '')}`;
const title = `Moving Company in ${area.name}, MT | Legacy Moving Co.`;
const description = `Legacy Moving Co. is a moving company in ${area.name}, MT offering local and long-distance moving, packing, and specialty services. Get a free, itemized quote.`;
const breadcrumbItems = [
  { label: 'Home', url: new URL('/', Astro.site).toString() },
  { label: 'Service Areas', url: new URL('/#service-areas', Astro.site).toString() },
  { label: area.name, url: new URL(`/moving-company-${area.slug}/`, Astro.site).toString() },
];

const featuredServices = services.filter((s) => guide.serviceSlugs.includes(s.slug));
const nearbyAreas = guide.nearbySlugs
  .map((slug) => areas.find((a) => a.slug === slug))
  .filter((a): a is Area => Boolean(a));

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guide.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
});
---

<BaseLayout title={title} description={description}>
  <BreadcrumbSchema slot="header" items={breadcrumbItems} />
  <Header slot="header" links={navLinks} phone={PHONE} ctaLabel="Get a Quote" ctaHref="/#quote" />

  <!-- 1. Hero -->
  <section class="city-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/#service-areas">Service Areas</a>
        <span aria-hidden="true">/</span>
        <span>{area.name}</span>
      </nav>
      <span class="hero-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        </svg>
        Licensed &amp; Insured Local Movers
      </span>
      <h1>Moving Company in {area.name}, MT</h1>
      <p class="hero-intro">{guide.intro}</p>
      <div class="hero-actions">
        <a class="btn-primary" href="/#quote">Get a Free Moving Quote</a>
        <a class="btn-secondary" href={phoneHref}>Call {PHONE}</a>
      </div>
    </div>
  </section>

  <!-- 2. Quick trust / USP bar -->
  <section class="trust-strip">
    <div class="container trust-strip-inner">
      {guide.trustBar.map((item, i) => (
        <>
          <span class="trust-strip-item">{item}</span>
          {i < guide.trustBar.length - 1 && <span class="trust-strip-divider" aria-hidden="true">|</span>}
        </>
      ))}
    </div>
  </section>

  <!-- 3. Moving services in [City] -->
  <section class="city-section">
    <div class="container">
      <h2>Moving Services in {area.name}</h2>
      <p class="section-lede">
        Every Legacy Moving service is available in {area.name}. Each one links to the full details on our main
        services page.
      </p>
      <div class="city-services-grid">
        {featuredServices.map((service) => (
          <a class="city-service-card" href={`/services/${service.slug}/`}>
            <span class="city-service-name">{service.cardTitle}</span>
            <span class="city-service-body">{service.cardBody}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Why Legacy in [City] -->
  <section class="city-section city-section--muted">
    <div class="container prose">
      <h2>Why Choose Legacy Moving in {area.name}?</h2>
      {guide.whyLegacy.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <!-- 5. Local moving knowledge -->
  <section class="city-section">
    <div class="container">
      <h2>Moving to or From {area.name}, MT?</h2>
      <div class="local-guide-grid">
        {guide.localGuide.map((item) => (
          <div class="local-guide-card">
            <h3>{item.heading}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Moving process -->
  <HowItWorks />

  <!-- 7. Local proof / reviews -->
  <section class="city-section city-section--muted">
    <div class="container">
      <h2>What {area.name} Customers Say</h2>
      <div class="review-grid">
        {guide.reviews.map((review) => (
          <div class="review-card">
            <div class="review-stars" aria-hidden="true">
              {Array.from({ length: 5 }).map(() => (
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2 14.7 9h7.3l-5.9 4.3L18.1 21 12 16.6 5.9 21l2-7.7L2 9h7.3L12 2z" />
                </svg>
              ))}
            </div>
            <p class="review-quote">"{review.quote}"</p>
            <p class="review-name">{review.name}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Nearby service areas -->
  {
    nearbyAreas.length > 0 && (
      <section class="city-section">
        <div class="container">
          <h2>Proudly Serving {area.name} and Nearby Communities</h2>
          <div class="nearby-grid">
            {nearbyAreas.map((nearby) => (
              <a class="nearby-chip" href={`/moving-company-${nearby.slug}/`}>{nearby.name}</a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 9. FAQ -->
  <section class="city-section city-section--muted">
    <div class="container prose">
      <h2>{area.name} Moving FAQ</h2>
      {guide.faq.map((item) => (
        <details class="faq-item">
          <summary>
            <span>{item.q}</span>
            <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <p class="faq-answer">{item.a}</p>
        </details>
      ))}
    </div>
    <script type="application/ld+json" set:html={faqSchema} />
  </section>

  <!-- 10. Final CTA -->
  <ClosingCta phone={PHONE} quoteHref="/#quote" heading={`Ready to Move in ${area.name}?`} />

  <Footer slot="footer" logoText="Legacy Moving Co." groups={footerGroups} phone={PHONE} email={EMAIL} />
</BaseLayout>

<style>
  .city-hero {
    background: var(--color-dark);
    color: var(--color-dark-fg);
    padding-block: var(--space-7);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: var(--space-4);
  }
  .crumbs a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: var(--color-accent-2);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: var(--space-4);
  }
  .city-hero h1 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2.2rem, 4.2vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #ffffff;
    max-width: 22ch;
    margin-bottom: var(--space-4);
  }
  .hero-intro {
    font-family: var(--font-body);
    font-size: 1.1rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.82);
    max-width: 62ch;
    margin-bottom: var(--space-5);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-weight: 700;
    font-family: var(--font-heading);
  }
  .btn-primary {
    background: var(--color-primary);
    color: var(--color-primary-fg);
  }
  .btn-secondary {
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
  }

  .trust-strip {
    background: var(--color-primary);
    padding-block: var(--space-3);
  }
  .trust-strip-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-3);
  }
  .trust-strip-item {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-primary-fg);
    white-space: nowrap;
  }
  .trust-strip-divider {
    color: rgba(1, 19, 47, 0.35);
    font-weight: 700;
  }

  .city-section {
    padding-block: var(--space-8);
    background: var(--color-bg);
    scroll-margin-top: 96px;
  }
  .city-section--muted {
    background: var(--color-muted);
  }
  .city-section h2 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-fg);
    margin-bottom: var(--space-4);
  }
  .section-lede {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--color-gray);
    max-width: 68ch;
    margin-bottom: var(--space-5);
  }
  .prose {
    max-width: 760px;
  }
  .prose p {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-gray);
    max-width: 68ch;
    margin-bottom: var(--space-3);
  }

  .city-services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .city-service-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-4);
    border: 2px solid var(--color-dark);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--color-fg);
    background: #ffffff;
    transition: transform 0.15s ease;
  }
  .city-service-card:hover {
    transform: translateY(-4px);
  }
  .city-service-name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1rem;
    text-transform: uppercase;
  }
  .city-service-body {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-gray);
  }

  .local-guide-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }
  .local-guide-card {
    padding: var(--space-5);
    background: var(--color-muted);
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--color-primary);
  }
  .local-guide-card h3 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-fg);
    margin-bottom: var(--space-2);
  }
  .local-guide-card p {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-gray);
    margin: 0;
  }

  .review-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  .review-card {
    background: #ffffff;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    padding: var(--space-5);
  }
  .review-stars {
    display: flex;
    gap: 3px;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }
  .review-quote {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-fg);
    margin-bottom: var(--space-3);
  }
  .review-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-gray);
    margin: 0;
  }

  .nearby-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .nearby-chip {
    padding: 12px 22px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: #ffffff;
    color: var(--color-fg);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
  }
  .nearby-chip:hover {
    border-color: var(--color-primary);
    color: var(--color-accent);
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: #ffffff;
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-3);
  }
  .faq-item[open] {
    border-color: var(--color-primary);
  }
  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-fg);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item .chevron {
    flex-shrink: 0;
    color: var(--color-gray);
    transition: transform 0.2s ease;
  }
  .faq-item[open] .chevron {
    transform: rotate(180deg);
    color: var(--color-primary);
  }
  .faq-answer {
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--color-gray);
    margin-top: var(--space-3);
  }

  @media (max-width: 1100px) {
    .city-services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 860px) {
    .local-guide-grid,
    .review-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .city-services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
