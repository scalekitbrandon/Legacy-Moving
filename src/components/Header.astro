---
interface NavChild {
  label: string;
  href: string;
}

interface NavLink {
  label: string;
  href: string;
  children?: NavChild[];
}

interface Props {
  links?: NavLink[];
  phone?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  links = [],
  phone = '406-539-9641',
  ctaLabel = 'Get a Quote',
  ctaHref = '/contact/',
} = Astro.props;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="/" aria-label="Legacy Moving Co.">
      <img class="logo-mark" src="/logo.png" alt="Legacy Moving Co." width="1138" height="660" />
    </a>

    <nav class="primary-nav">
      <ul>
        {links.map((link) => (
          <li class={link.children ? 'has-dropdown' : ''}>
            <a href={link.href}>
              {link.label}
              {link.children && (
                <svg class="caret" width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </a>
            {link.children && (
              <ul class="dropdown">
                {link.children.map((child) => (
                  <li><a href={child.href}>{child.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a class="phone-pill" href={`tel:${phone.replace(/[^\d+]/g, '')}`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"
            fill="currentColor"
          />
        </svg>
        <span>{phone}</span>
      </a>
      <a class="header-cta" href={ctaHref}>{ctaLabel}</a>
    </div>

    <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav">
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
          {link.children && (
            <ul class="mobile-children">
              {link.children.map((child) => (
                <li><a href={child.href}>{child.label}</a></li>
              ))}
            </ul>
          )}
        </li>
      ))}
      <li><a href={ctaHref} class="mobile-cta">{ctaLabel}</a></li>
    </ul>
  </nav>
</header>

<div class="header-spacer" aria-hidden="true"></div>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--color-dark);
  }
  .header-spacer {
    height: 72px;
  }
  .header-inner {
    max-width: var(--container-wide);
    padding-inline: 24px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo-mark {
    height: 54px;
    width: auto;
    display: block;
  }

  @media (max-width: 480px) {
    .logo-mark {
      height: 44px;
    }
  }

  .primary-nav > ul {
    display: flex;
    gap: 48px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .primary-nav > ul > li {
    position: relative;
    padding-block: 10px;
  }
  .primary-nav a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--color-dark-fg);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 16.15px;
    font-weight: 600;
    opacity: 0.8;
    transition: opacity 0.15s ease;
  }
  .primary-nav a:hover {
    opacity: 1;
  }
  .primary-nav .caret {
    opacity: 0.7;
    transition: transform 0.15s ease;
  }
  .has-dropdown:hover .caret,
  .has-dropdown:focus-within .caret {
    transform: rotate(180deg);
  }

  .dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, -6px);
    margin-top: 0;
    min-width: 260px;
    max-height: 70vh;
    overflow-y: auto;
    background: #ffffff;
    border-radius: var(--radius-md);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.22);
    list-style: none;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease, transform 0.15s ease;
    z-index: 50;
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  .dropdown li {
    break-inside: avoid;
  }
  .dropdown a {
    display: block;
    width: 100%;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    color: var(--color-fg);
    font-weight: 600;
    font-size: 0.9rem;
    opacity: 1;
    white-space: normal;
  }
  .dropdown a:hover {
    background: var(--color-muted);
    color: var(--color-accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .phone-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .header-cta {
    padding: 10px 22px;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-primary-fg);
    font-weight: var(--font-weight-button);
    text-decoration: none;
    white-space: nowrap;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }
  .menu-toggle span {
    display: block;
    height: 2px;
    background: var(--color-dark-fg);
    border-radius: 2px;
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 860px) {
    .primary-nav,
    .header-actions .phone-pill {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
    .mobile-nav.open {
      display: block;
      max-height: calc(100vh - 72px);
      overflow-y: auto;
      background: var(--color-dark);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }
    .mobile-nav ul {
      list-style: none;
      margin: 0;
      padding: var(--space-3) 24px;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .mobile-nav a {
      color: var(--color-dark-fg);
      text-decoration: none;
      font-weight: 600;
    }
    .mobile-nav .mobile-cta {
      color: var(--color-primary);
    }
    .mobile-children {
      list-style: none;
      margin: 10px 0 0;
      padding: 0 0 0 16px !important;
      display: flex;
      flex-direction: column;
      gap: 10px !important;
      border-left: 2px solid rgba(255, 255, 255, 0.15);
    }
    .mobile-children a {
      font-weight: 500;
      font-size: 0.92rem;
      opacity: 0.8;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const nav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });
</script>
