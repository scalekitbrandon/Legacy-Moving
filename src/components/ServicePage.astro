---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import HowItWorks from './HowItWorks.astro';
import ClosingCta from './ClosingCta.astro';
import BreadcrumbSchema from './BreadcrumbSchema.astro';
import { services, type Service } from '../data/services';
import { navLinks, footerGroups, PHONE, EMAIL } from '../data/site';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const related = services.filter((s) => service.related.includes(s.slug));
const phoneHref = `tel:${PHONE.replace(/[^\d+]/g, '')}`;
const breadcrumbItems = [
  { label: 'Home', url: new URL('/', Astro.site).toString() },
  { label: 'Services', url: new URL('/services/', Astro.site).toString() },
  { label: service.navLabel, url: new URL(`/services/${service.slug}/`, Astro.site).toString() },
];
const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
});
---

<BaseLayout title={service.title} description={service.description}>
  <BreadcrumbSchema slot="header" items={breadcrumbItems} />
  <Header slot="header" links={navLinks} phone={PHONE} ctaLabel="Get a Quote" ctaHref="/#quote" />

  <section class="detail-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/services/">Services</a>
        <span aria-hidden="true">/</span>
        <span>{service.navLabel}</span>
      </nav>
      <h1>{service.h1}</h1>
      <p class="detail-intro">{service.intro}</p>
      <div class="detail-actions">
        <a class="btn-primary" href="/#quote">Get My Free Quote</a>
        <a class="btn-secondary" href={phoneHref}>Call {PHONE}</a>
      </div>
    </div>
  </section>

  <section class="detail-section">
    <div class="container prose">
      <h2>What it includes</h2>
      {service.whatItIs.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="detail-section detail-section--muted">
    <div class="container">
      <h2>Who this service is for</h2>
      <ul class="who-grid">
        {service.whoItHelps.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="detail-section">
    <div class="container prose">
      <h2>How we approach it</h2>
      {service.approach.map((p) => <p>{p}</p>)}
    </div>
  </section>

  {
    service.extra && (
      <section class="detail-section detail-section--muted" id={service.extra.id}>
        <div class="container prose">
          <h2>{service.extra.heading}</h2>
          {service.extra.body.map((p) => <p>{p}</p>)}
        </div>
      </section>
    )
  }

  <HowItWorks />

  <section class="detail-section detail-section--muted">
    <div class="container prose faq-wrap">
      <h2>Frequently asked questions</h2>
      {service.faq.map((item) => (
        <details class="faq-item">
          <summary>
            <span>{item.q}</span>
            <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <p class="faq-answer">{item.a}</p>
        </details>
      ))}
    </div>
    <script type="application/ld+json" set:html={faqSchema} />
  </section>

  {
    related.length > 0 && (
      <section class="detail-section">
        <div class="container">
          <h2 class="related-title">Related services</h2>
          <div class="related-grid">
            {related.map((item) => (
              <a class="related-card" href={`/services/${item.slug}/`}>
                <span class="related-name">{item.cardTitle}</span>
                <span class="related-body">{item.cardBody}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <ClosingCta phone={PHONE} quoteHref="/#quote" />

  <Footer slot="footer" logoText="Legacy Moving Co." groups={footerGroups} phone={PHONE} email={EMAIL} />
</BaseLayout>

<style>
  .detail-hero {
    background: var(--color-dark);
    color: var(--color-dark-fg);
    padding-block: var(--space-7) var(--space-8);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: var(--space-4);
  }
  .crumbs a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }
  .detail-hero h1 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2.2rem, 4.2vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #ffffff;
    max-width: 22ch;
    margin-bottom: var(--space-4);
  }
  .detail-intro {
    font-family: var(--font-body);
    font-size: 1.1rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.82);
    max-width: 62ch;
    margin-bottom: var(--space-5);
  }
  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-weight: 700;
    font-family: var(--font-heading);
  }
  .btn-primary {
    background: var(--color-primary);
    color: var(--color-primary-fg);
  }
  .btn-secondary {
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
  }

  .detail-section {
    padding-block: var(--space-8);
    background: var(--color-bg);
    scroll-margin-top: 96px;
  }
  .detail-section--muted {
    background: var(--color-muted);
  }
  .detail-section h2 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-fg);
    margin-bottom: var(--space-4);
  }
  .prose p {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-gray);
    max-width: 68ch;
    margin-bottom: var(--space-3);
  }

  .who-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .who-grid li {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--color-fg);
  }

  .faq-wrap .faq-item {
    max-width: 820px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: #ffffff;
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-3);
  }
  .faq-item[open] {
    border-color: var(--color-primary);
  }
  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-fg);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item .chevron {
    flex-shrink: 0;
    color: var(--color-gray);
    transition: transform 0.2s ease;
  }
  .faq-item[open] .chevron {
    transform: rotate(180deg);
    color: var(--color-primary);
  }
  .faq-answer {
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--color-gray);
    margin-top: var(--space-3);
  }

  .related-title {
    margin-bottom: var(--space-4);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 2px solid var(--color-dark);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--color-fg);
    background: #ffffff;
  }
  .related-name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.1rem;
    text-transform: uppercase;
  }
  .related-body {
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-gray);
  }

  @media (max-width: 900px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .who-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
