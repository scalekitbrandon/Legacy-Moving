---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BreadcrumbSchema from '../../components/BreadcrumbSchema.astro';
import GhlForm from '../../components/GhlForm.astro';
import { navLinks, footerGroups, PHONE, EMAIL } from '../../data/site';

const phoneHref = `tel:${PHONE.replace(/[^\d+]/g, '')}`;
const breadcrumbItems = [
  { label: 'Home', url: new URL('/', Astro.site).toString() },
  { label: 'Contact', url: new URL('/contact/', Astro.site).toString() },
];
---

<BaseLayout
  title="Contact Legacy Moving Co. | Bozeman, MT"
  description="Get a free, itemized moving quote from Legacy Moving Co. Call 406-539-9641 or send your move details and we'll get back to you."
>
  <BreadcrumbSchema slot="header" items={breadcrumbItems} />
  <Header slot="header" links={navLinks} phone={PHONE} ctaLabel="Get a Quote" ctaHref="/contact/" />

  <section class="contact-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>Contact</span>
      </nav>
      <h1>Contact Legacy Moving Co.</h1>
      <p class="contact-intro">
        Tell us about your move and we'll follow up with a free, itemized quote. Prefer to talk it through? Call us
        directly.
      </p>
      <a class="btn-secondary" href={phoneHref}>Call {PHONE}</a>
    </div>
  </section>

  <section class="contact-section">
    <div class="container contact-grid">
      <div class="contact-form-card">
        <h2>Request Your Free Quote</h2>
        <p class="form-sub">Takes under 60 seconds</p>
        <GhlForm />
      </div>

      <div class="contact-info">
        <div class="contact-info-item">
          <span class="contact-info-label">Phone</span>
          <a class="contact-info-value" href={phoneHref}>{PHONE}</a>
        </div>
        <div class="contact-info-item">
          <span class="contact-info-label">Email</span>
          <a class="contact-info-value" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </div>
        <div class="contact-info-item">
          <span class="contact-info-label">Service Area</span>
          <span class="contact-info-value">Bozeman, Big Sky, Belgrade, Livingston, and Southwest Montana</span>
        </div>
        <div class="contact-info-item">
          <span class="contact-info-label">Hours</span>
          <span class="contact-info-value">Open 24 Hours</span>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" logoText="Legacy Moving Co." groups={footerGroups} phone={PHONE} email={EMAIL} />
</BaseLayout>

<style>
  .contact-hero {
    background: var(--color-dark);
    color: var(--color-dark-fg);
    padding-block: var(--space-7);
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: var(--space-4);
  }
  .crumbs a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }
  .contact-hero h1 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-bottom: var(--space-4);
  }
  .contact-intro {
    font-family: var(--font-body);
    font-size: 1.1rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.82);
    max-width: 56ch;
    margin-bottom: var(--space-5);
  }
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
    font-family: var(--font-heading);
  }

  .contact-section {
    background: var(--color-bg);
    padding-block: var(--space-8);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: var(--space-7);
    align-items: start;
  }

  .contact-form-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
  }
  .contact-form-card h2 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-fg);
    margin-bottom: 4px;
  }
  .form-sub {
    color: var(--color-gray);
    font-size: 0.9rem;
    margin-bottom: var(--space-5);
  }
  .contact-form-card form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .contact-form-card label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-fg);
    margin-bottom: -6px;
  }
  .form-row {
    display: flex;
    gap: var(--space-3);
  }
  .form-field {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }
  .contact-form-card input,
  .contact-form-card textarea {
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    font-family: var(--font-body);
    font-size: 0.95rem;
    resize: vertical;
  }
  .contact-form-card button {
    margin-top: var(--space-2);
    padding: 14px;
    border-radius: var(--radius-md);
    border: none;
    background: var(--color-primary);
    color: var(--color-primary-fg);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .contact-info-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .contact-info-label {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray);
  }
  .contact-info-value {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-fg);
    text-decoration: none;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
